                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using live attenuated Brucella abortus delta pgk mutant strain. Delta pgk mutant strain exhibited extreme attenuation and induced protective immunity superior to that conferred by commercial strain 19 or RB51 vaccines in both immunocompetent and immunocompromised mice. Mutant strain showed altered intracellular trafficking with retention in late endosomal/lysosomal compartments (lamp1 positive), indicating impaired intracellular survival.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:20194591</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus 2308 delta pgk vaccine</rdfs:label>
    </owl:Class>
    


