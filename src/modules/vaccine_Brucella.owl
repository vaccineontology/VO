            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella ovis vaccine using B. Ovis δabcba strain encapsulated with sterile alginate or non encapsulated vaccine strain. Immunization, particularly with encapsulated b. Ovis δabcba, prevented infection, secretion of wild type b. Ovis in semen and urine, shedding of neutrophils in semen, and development of clinical changes, gross and microscopic lesions induced by wild type b. Ovis.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:26317399</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32965738</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40152064</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella ovis delta abcBA vaccine</rdfs:label>
    </owl:Class>
    


