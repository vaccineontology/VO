                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using the vaccine consisted of bacterial ghosts derived from Brucella abortus strain 2308 with a gntr gene deletion. 2308ΔgntR ghost induced high protective immunity against challenge with virulent Brucella abortus strain S2308 in balb/c mice. Vaccine elicited a strong anti-brucella-specific igg response, induced secretion of ifn-γ and IL-4 cytokines, and stimulated robust spleen cd4+ and cd8+ T cell responses.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:32559678</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus 2308 delta gntR bacterial ghost vaccine</rdfs:label>
    </owl:Class>
    


