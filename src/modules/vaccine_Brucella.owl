                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_29459"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella melitensis recombinant vector vaccine using live escherichia coli BL21 (de3) pet15b expressing Brucella P39 protein administered intraperitoneally twice at 4-week intervals. Vaccination significantly reduced the number of Brucella melitensis strain 16 M bacteria in spleens compared to saline controls (p&lt;0.001). Vaccine elicited t-cell proliferative responses, induced gamma interferon production upon antigen re-stimulation, and generated strong humoral responses including igg1 and igg2a antibodies.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:20036752</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22296786</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella melitensis P39 recombinant vector vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009223 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009223">
