                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine using passive administration of O polysaccharide-specific igg2a and igg1 monoclonal antibodies and convalescent-phase serum. 82% of mice infected with 100 CFU of b. Abortus preincubated with igg2a mab were free of infection up to 6 weeks. Antibodies of appropriate specificity and isotype (igg2a) were effective in opsonizing b. Abortus and facilitating killing by activated macrophages.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:2509362</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:9582954</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus O-polysaccharide subunit vaccine</rdfs:label>
    </owl:Class>
    


