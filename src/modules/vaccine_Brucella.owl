                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella suis subunit vaccine using Brucella suis polysaccharide protein subunit vaccine. Vaccinated mice showed statistically significant reduction in bacterial colonization compared to unvaccinated controls. A single immunization induced a serum igg response to Brucella antigens that remained elevated for up to 9 weeks.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:25320267</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella suis polysaccharide protein subunit vaccine</rdfs:label>
    </owl:Class>
    


