                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine using Brucella abortus dihydrolipoamide succinyltransferase subunit vaccine. Re2o vaccine provided partial protection against challenge with pathogenic Brucella abortus in balb/c mice. Vaccine induced high igg antibody and its isotypes igg1, significant production of ifn-γ, il-10, and IL-4 cytokines, and significant lymphoproliferation of splenocytes, indicating a mixed but predominant th2 type.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:22806154</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus dihydrolipoamide succinyltransferase subunit vaccine</rdfs:label>
    </owl:Class>
    


