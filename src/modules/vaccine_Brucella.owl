        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine that a recombinant Brucella abortus strain Bru-M3 by deleting eipB, per, and wadC genes to remodel noncanonical LPS and produce outer-membrane vesicles (OMVs) at higher yield and enhanced immunogenicity compared to wild-type OMVs.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:41272796</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus strain delta eipB delta per delta wadC vaccine</rdfs:label>
    </owl:Class>
    


