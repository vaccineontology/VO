                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_29459"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella melitensis subunit vaccine using OMVs administered twice during antibiotic therapy. No additive effect on clearance of b. Melitensis. Omv vaccinated mice developed significantly higher anti-brucella igg antibody titers at end of treatment compared to mice receiving only antibiotics.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:23163875</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24397905</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32454410</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41207070</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella melitensis outer membrane vesicle subunit vaccine</rdfs:label>
    </owl:Class>
    


