                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella subunit vaccine using Brucella TF BP26 omp31 subunit vaccine. Recombinant protein and nanoparticle formulations induced significant. Significant production of igg1, igg2a, ifn-γ, il-12, and IL-4 cytokines indicating stimulation of both cellular and humoral immunity compared to positive and negative control groups.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:39343859</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella TF BP26 omp31 subunit vaccine</rdfs:label>
    </owl:Class>
    


