            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Inactivated Brucella abortus vaccine using heat-inactivated whole Brucella abortus bacteria were used to stimulate human monocytes. Heat-inactivated b. Abortus induced IL-12 secretion by monocytes, which enhanced ifn-gamma mrna expression in T cells and increased NK cell cytolytic activity, indicating potential for directing. B. Abortus stimulation led to IL-12 p40 mrna and protein secretion, upregulation of costimulatory molecules b7.1, b7.2, and intercellular adhesion molecule 1 on monocytes, increased ifn-gamma expression in T cells, and enhanced NK cytolytic activity, supporting activation of cellular immunity.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:8757841</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>inactivated Brucella abortus heat-vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009112 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001223"/>
