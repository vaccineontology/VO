            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella canis subunit vaccine using blsomp31 antigen adsorbed to aluminum hydroxide gel (blsomp31-ah). Vaccine elicited specific antibodies 3 weeks after the first immunization. Antibody profile corresponded to a marked th2 response with predominance of igg1 over igg2. Cellular.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:28166930</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella canis BLSOmp31 subunit vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009377 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009377">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0009006"/>
