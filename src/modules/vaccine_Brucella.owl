                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using A wbka gene knockout mutant of Brucella abortus strain 19 was constructed to produce a strain deficient in LPS o-chain structure. Wbka mutant induced a splenocyte proliferative response in mice comparable or superior to parental S19 and RB51 strains, indicating immunogenicity. Mutant strain did not induce igm antibody response detectable by elisa, suggesting reduced interference in serological differentiation between vaccinated and infected animals.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:32195284</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus strain 19 wbkA gene deletion vaccine</rdfs:label>
    </owl:Class>
    


