                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003355"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus DNA vaccine using plasmid DNA carrying the open reading frame with homology to an abc-type transporter (pv278a) administered by intramuscular injection. Vaccine induced protection in balb/c mice against challenge with virulent Brucella abortus 2308. Vaccine elicited a dominant igg2a antibody response, t-cell proliferative response, and significant interferon gamma (ifn-γ) production upon restimulation with recombinant 278a protein.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:23834811</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus ABC-type transporter DNA vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009286 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009286">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0009011"/>
        <rdfs:subClassOf>
