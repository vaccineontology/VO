            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella melitensis vaccine using unmarked deletion mutant live attenuated vaccine strain bmdeltaasp24. Bmdeltaasp24 was protective against abortion and infection in the majority of pregnant goats and was more efficacious than bmdeltavirb2 against challenge infection.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:16697090</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:17664263</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella melitensis asp24 deletion mutant vaccine</rdfs:label>
    </owl:Class>
    


