            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella ovis subunit vaccine using HS was entrapped in conventional and mannosylated poly(anhydride) nanoparticles prepared by solvent displacement method.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:19442721</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
