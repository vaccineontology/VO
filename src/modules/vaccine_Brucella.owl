                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using live betb deletion mutant strain of Brucella abortus. Betb mutant was predominantly cleared from mouse spleens after 2 weeks post-infection and vaccination with the live betb mutant provided effective protection against challenge with the virulent wild-type strain. Betb mutant showed increased adherence to host cells and enhanced phosphorylation of protein kinases promoting phagocytic activity.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:24210811</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus betB deletion mutant vaccine</rdfs:label>
    </owl:Class>
    


