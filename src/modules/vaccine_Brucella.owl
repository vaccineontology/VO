                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella subunit vaccine using A chitosan-based nasal vaccine formulated with Brucella immunogens sodc, omp19, bls, and PrpA. Vaccinated mice showed significant reduction of Brucella recovery in lungs and spleen compared to PBS control after nasal challenge. Vaccination induced significantly higher systemic igg and mucosal iga responses.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>chitosan-based Brucella nasal vaccine (BNV) plus Brucella LPS</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:30593355</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella SodC Omp19 BLS PrpA LPS chitosan nanoparticle vaccine</rdfs:label>
    </owl:Class>
    


