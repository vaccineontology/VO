                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_29459"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella melitensis subunit vaccine using omp31 protein loaded on calcium phosphate nanoparticles (cp/omp31). Cp/omp31 nanoparticles elicited protection against Brucella melitensis challenge equivalent to the vaccine strain Brucella melitensis strain Rev. 1 and showed a low increase in protection compared to cs/omp31 nanoparticles. Cp/omp31 induced a mixed T helper type 1 (th1) and T helper type 2 (th2).</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:30707922</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella melitensis Omp31 subunit vaccine with aluminum hydroxide nanoparticles</rdfs:label>
    </owl:Class>
    


