                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella melitensis vaccine using the wboa and pag genes were cloned into plasmid pbbr4mcs and introduced into o-antigen deficient B. Melitensis strain WRRP1 to produce strain wrspa, which expressed o-antigen and protective antigen products. Strain WRSPA induced protection in balb/c mice against b. Melitensis 16M challenge but failed to protect A/J mice against b. Anthracis sterne strain challenge.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:19397881</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella melitensis strain WRRP1 vaccine expressing wboA and Bacillus anthracis protective antigen</rdfs:label>
    </owl:Class>
    


