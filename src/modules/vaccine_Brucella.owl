                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10141"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella melitensis recombinant vector vaccine using recombinant influenza viral vectors subtype H5N1 expressing Brucella omp16, l7/l12, omp19, or cu-zn SOD proteins. Double intranasal immunization at 10^6 EID50 dose provided 80% protection of guinea pigs from b. Melitensis 16M infection, comparable to the commercial b. Melitensis strain Rev. 1 vaccine.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>recombinant influenza viral vector vaccine expressing Brucella outer membrane proteins and Cu-Zn SOD</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:33274194</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33593447</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella melitensis Omp16 L7/L12 Omp19 Cu-Zn SOD recombinant vector vaccine</rdfs:label>
    </owl:Class>
    


