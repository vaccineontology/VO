            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella melitensis vaccine using live attenuated wboa deletion mutant of B. Melitensis strain M5-90. M5-90δwboa strain showed reduced survival in macrophages and mice, induced protective immunity comparable to parental M5-90 strain in mice, and elicited specific igg and cytokine responses. Induced anti-brucella-specific igg, secretion of ifn-γ and IL-2 in mice.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>B. melitensis vaccine strain M5-90ΔwboA</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:25899866</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella melitensis strain M5-90 wboA deletion vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009327 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009327">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0009011"/>
