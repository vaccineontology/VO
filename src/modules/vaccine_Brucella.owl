                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9940"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella melitensis vaccine using live attenuated Brucella melitensis conjunctival vaccine. Antibody titers increased significantly at the first month post-vaccination (p &lt; 0.001) but began to decline by the second month. Significant increase in antibody titers at one month post-vaccination.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:30145690</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella melitensis conjunctival vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009406 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009406">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001135"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
