                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003355"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using recombinant lactococcus lactis expressing the omp10 protein using the pnz8148 vector with usp45 signal peptide was constructed and administered orally. Mice vaccinated with l. Lactis-pnz8148-omp10-usp45 showed significantly higher omp10-specific total igg and igg1 compared to PBS controls. Vaccinated mice had significantly elevated cytokine levels and reduced inflammatory response, morphological damage, alveolar edema, and lymphocyte infiltration after challenge. Vaccine induced strong humoral immunity with increased omp10-specific igg and igg1 antibodies and a mixed cytokine response including elevated ifn-γ, tnfα, il-4, and il-10, indicating activation of both th1 and th2.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:38170414</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus Omp10 recombinant vaccine</rdfs:label>
    </owl:Class>
    


