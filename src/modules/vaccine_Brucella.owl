                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella subunit vaccine using Brucella BP26 subunit vaccine. Vaccine candidate induced strong cellular. Induction of M1 macrophage polarization, stimulation of th1 and cd8+ T cell responses, high titers of rbp26-specific antibodies, activation and proliferation of T lymphocytes, cytokine production, and maintenance of long-term immune memory.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
