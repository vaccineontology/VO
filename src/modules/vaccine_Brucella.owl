        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using live Brucella abortus strain 19 and its isogenic ∆mgla 3.14 deletion mutant. Brucella abortus strain 19 showed the highest susceptibility to oxidative stress and the lowest survival inside murine macrophages. Mgla deletion mutant induced cytokine production in macrophages, indicating an altered.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:32462327</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus strain 19 vaccine mglA deletion mutant vaccine</rdfs:label>
    </owl:Class>
    


