                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using recombinant fusion protein expressed and secreted into the Brucella periplasmic space using plasmid pbev in the live attenuated Brucella abortus strain 19. Recombinant antigen induced a good antibody response against the trypanosoma cruzi antigen. Induction of a good antibody response against the trypanosoma cruzi repetitive antigen was observed.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:9673273</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus strain 19 Trypanosoma cruzi CRA recombinant vaccine</rdfs:label>
    </owl:Class>
    


