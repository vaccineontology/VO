        <obo:IAO_0000115>Brucella suis subunit vaccine using Brucella suis btaf subunit vaccine. Nasal vaccination with btaf+c-di-amp did not protect against respiratory b. Suis challenge but conferred significant protection against intragastric challenge, reducing splenic bacterial load by 3.28 log CFU. Immunization induced increased serum igg and iga antibodies including mixed igg2a/igg1, mucosal iga, antibodies that reduced bacterial adhesion in vitro, increased il-2, il-5, il-17, and ifn-γ secretion by spleen cells, central memory cd4+ T cells in cervical lymph nodes, a btaf-specific delayed-type hypersensitivity response, and high ifn-γ production by lung cells upon antigen stimulation.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:31402921</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella suis BtaF subunit vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009430 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009430">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001223"/>
