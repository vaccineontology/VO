                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using live attenuated RB51 mutants with single deletions (δcydc, δcydd, δpurd) and double deletions (δcydcδcydd, δcydcδpurd) were generated. Single immunization with mutants induced lower protection than parental RB51. Mutants induced a mixed but t-helper-1-biased humoral and cellular.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>Brucella abortus strain RB51 ΔcydC ΔcydD live attenuated double mutant vaccine</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:26341622</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus strain RB51 cydC cydD double deletion vaccine</rdfs:label>
    </owl:Class>
    


