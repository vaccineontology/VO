                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003355"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9925"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Inactivated Brucella abortus vaccine using the vaccine consisted of approximately 3 × 10^9 gi24-lysed Brucella abortus cells administered subcutaneously. Three of five goats immunized with the gi24-lysed vaccine were completely protected against challenge. Group B showed significantly lower infection index and tissue colonization compared to controls. Immunized goats showed significantly higher ELISA optical density values for b. Abortus lipopolysaccharide and elevated cytokine levels (il-4, tnf-α, ifn-γ) compared to controls, indicating a strong.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>GI24-lysed Brucella abortus cells vaccine candidate</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:30670904</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>inactivated Brucella abortus GI24-lysed vaccine</rdfs:label>
    </owl:Class>
    


