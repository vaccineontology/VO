            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella ovis subunit vaccine using Brucella ovis hot saline complex subunit vaccine encapsulated in mannosylated nanoparticles. Vaccinated animals showed a 3-log reduction in spleen colony forming units compared to unvaccinated controls. Vaccine induced a strong and prolonged mucosal iga response superior to that induced by Rev. 1.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:22846987</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella ovis hot saline complex subunit vaccine encapsulated in mannosylated nanoparticles</rdfs:label>
    </owl:Class>
    


