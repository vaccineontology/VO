            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using mutant strain s2308δatp with ABC transporter atpase gene deletion, exhibiting rough phenotype and altered growth rate compared to wild type. Mutant strain s2308δatp showed attenuated virulence in vitro and in vivo. Expression levels of MHC i, MHC ii, and co-stimulatory molecules were investigated in mice following infection with s2308δatp and wild type s2308, indicating immune activation differences.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:23507429</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus 2308 delta BAB1_0542 vaccine</rdfs:label>
    </owl:Class>
    


