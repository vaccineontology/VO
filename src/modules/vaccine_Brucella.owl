                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using live attenuated double mutant strain with bp26 replaced by luciferase gene and partial deletion of bmp18, lacking drug resistance markers. Inta2 showed significantly reduced bacterial load in spleens during early infection and no splenomegaly, indicating reduced residual virulence. Inta2 induced o-side antibodies but did not express bp26, enabling differentiation of vaccinated animals from those infected with field strains by measuring anti-bp26 antibodies via agglutination test or ELISA.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:12079742</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:18565697</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus INTA2 vaccine</rdfs:label>
    </owl:Class>
    


