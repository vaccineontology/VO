            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Inactivated Brucella melitensis vaccine using inactivated Brucella melitensis vaccine designated CF. Cf demonstrated protective efficacy comparable to the S2 vaccine against b. Melitensis biovar 3 infection in mice. Cf induced significant increases in specific igg antibody levels against Brucella in early stages.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>Brucella inactivated vaccine (CF)</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:40280033</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>inactivated Brucella melitensis vaccine CF</rdfs:label>
    </owl:Class>
    


