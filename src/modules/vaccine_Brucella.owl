            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella melitensis subunit vaccine using Brucella melitensis wbkc subunit vaccine. Vaccination with rwbkc significantly reduced bacterial loads in spleen and liver compared to PBS control (p &lt; 0.001). Rwbkc induced significantly higher igg and igg1 antibody levels than wbkc protein.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>rWbkC multi-epitope vaccine</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:42133465</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella melitensis WbkC subunit vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009616 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009616">
