                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella conjugate vaccine using A chemically synthesized polysaccharide-protein conjugate vaccine targeting the Brucella A antigen, designed to not induce antibodies reactive in diagnostic tests based on the M antigen. Immunized mice developed antibodies to the Brucella A antigen that did not react in diagnostic tests based on the M antigen, indicating potential for improved vaccine specificity. Antibody response specific to the Brucella A antigen was elicited without generating antibodies that cause false positives in serodiagnostic tests targeting the M antigen.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:29219305</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella A antigen conjugate vaccine</rdfs:label>
    </owl:Class>
    


