            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella suis vaccine using live attenuated Brucella suis strain 2 vaccine adjuvanted with ag85a. Ag85a-s2 triggered a stronger cellular. Ag85a-s2 activated the cgas-sting signaling pathway, leading to increased abundance of interferon and other cytokines.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118> S2-Ag85A oral Brucella vaccine</obo:IAO_0000118>
        <obo:IAO_0000118>live-attenuated Brucella suis strain 2 vaccine (S2) adjuvanted with Ag85a </obo:IAO_0000118>
        <obo:IAO_0000119>PMID:36560581</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36601429</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella suis strain 2 vaccine adjuvanted with Ag85a adjuvant</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009518 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009518">
