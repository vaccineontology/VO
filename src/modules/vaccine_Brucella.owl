                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0001011"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_11077"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003355"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_29459"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella melitensis subunit vaccine using exosomes carrying Brucella antigen components including omp31 and ompa derived from infected macrophages. Exo-m5 promoted M1 macrophage polarization, induced secretion of M1 cytokines (tnf-α, ifn-γ), inhibited M2 cytokine (il-10), reduced intracellular Brucella survival, increased igg2a antibody release, protected mice from Brucella infection, and reduced spleen parasitaemia. Activation of nf-κb signaling pathways, promotion of M1 macrophage polarization, increased secretion of proinflammatory cytokines tnf-α and ifn-γ, decreased IL-10 secretion, and enhanced igg2a antibody production.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:37212362</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella melitensis Omp31 and OmpA subunit vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009536 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009536">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0000957"/>
