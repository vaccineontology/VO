                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Inactivated Brucella abortus vaccine with oil. Vaccinated mice showed significantly reduced spleen weight and bacterial load compared to unvaccinated controls after challenge (p &lt; 0.001), indicating protective efficacy. Vaccinated mice developed Brucella abortus-specific serum igg from 2 weeks post-vaccination with peak titers at 5-6 weeks (p &lt; 0.001).</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:40013279</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>inactivated Brucella abortus vaccine with oil adjuvant</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009573 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009573">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001135"/>
