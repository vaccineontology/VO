                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine using Brucella abortus omp28 subunit vaccine. Romp28-immunized mice showed 20-fold higher igg1 and igg2a titers compared to controls. Induction of both humoral (igg1) and cell-mediated (igg2a).</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:23000585</obo:IAO_0000119>
