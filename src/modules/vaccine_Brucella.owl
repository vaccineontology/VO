                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_29459"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella melitensis DNA vaccine using recombinant plasmid pcdna3.1/hygro (+) encoding omp25 gene. Induced significant immunoglobulin G response, t-cell proliferation, and interferon gamma production compared to controls. Both humoral and cellular immunity were induced, with dominant igg response and significant inf-γ production.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:30524697</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella melitensis Omp25 and Omp31 DNA vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009410 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009410">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001225"/>
