            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine using protein-bound peptidoglycan fraction derived from Brucella abortus cell wall. Transferred lymph node and spleen cells conferred immunity reducing Brucella counts. Cell-mediated immunity involving both t-enriched and b-enriched cells.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:3451687</obo:IAO_0000119>
