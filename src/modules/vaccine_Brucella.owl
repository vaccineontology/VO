        <obo:IAO_0000115>Brucella abortus RNA vaccine using recombinant semliki forest virus particles (sfv-sod particles) expressing the SOD protein. Sfv-sod particles induced significant protection in balb/c mice against challenge with virulent b. Abortus strain 2308 compared to control virus particles. Induced t-cell proliferative response and gamma interferon secretion without sod-specific antibodies.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:15908354</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus SFV-SOD recombinant vector RNA vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009165 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009165">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0000957"/>
