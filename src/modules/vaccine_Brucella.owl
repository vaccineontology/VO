            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using live brucellosis vaccine from Brucella abortus strain 82 combined sequentially with a lysed low-molecular Brucella component (glucopeptide). Combined administration increased the number of immune animals by 1.5-2 times compared to animals receiving only one preparation. Synergistic effect observed on antibacterial immunity index with sequential injection of glucopeptide and live vaccine.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>live brucellosis vaccine prepared from Br. abortus 82</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:6774529</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus strain 82 vaccine</rdfs:label>
    </owl:Class>
    


