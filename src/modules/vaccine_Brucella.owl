            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Inactivated Brucella abortus vaccine using inactivated Brucella abortus strain 544 vaccine. Highly active and immunizing in mice and guinea-pigs. Produced delayed hypersensitivity in guinea-pigs.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>purified killed Brucella abortus vaccine from smooth strain 544</obo:IAO_0000118>
