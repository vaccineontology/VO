        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine that is Δomp19::kan mutant strain of Brucella abortus was evaluated as a live vaccine candidate due to its attenuation and residual virulence in mouse models.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:25644010</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus outer membrane protein 19 delta vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009319 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009319">
