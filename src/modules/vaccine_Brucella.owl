            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using the vaccine consisted of recombinant lactococcus lactis expressing and secreting the BLS protein, delivered orally. Vaccinated mice showed significant bls-specific igg1 and igg2a antibody responses compared to controls. Vaccine induced both humoral (igg1, igg2a) and cellular.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>Lactococcus lactis-pNZ8148-BLS-Usp45 vaccine</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:36939918</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus BLS Lactococcus lactis vector vaccine</rdfs:label>
    </owl:Class>
    


