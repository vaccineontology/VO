                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using Brucella abortus strain 19 vaccine pulsed with lytic brucellaphage (phage pulsed vaccine preparation). Phage pulsed vaccine induced sustained and significantly high titers of anti-brucella antibodies compared with untreated animals and animals vaccinated with S19 vaccine alone. Induction of specific and sustained high titers of anti-brucella antibodies measured by multiple serological assays.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:36147290</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus strain 19 brucellaphage-treated vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009515 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009515">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001135"/>
        <rdfs:subClassOf>
