        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella melitensis lipopolysaccharide subunit vaccine with MONTANIDE ISA 61 VG adjuvant</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009600 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009600">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001135"/>
