                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003355"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using live attenuated Brucella abortus delta rpoe1 vaccine. Mice immunized with δrpoe1 completely resisted wild-type infection and showed reduced splenomegaly and bacterial burden compared to wild-type infected mice. Immunization elicited significantly higher brucella-specific serum igg, igg2a, and ifn-γ levels compared to naïve mice, indicating a strong adaptive.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:27591954</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus delta rpoE1 vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009366 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009366">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001134"/>
        <rdfs:subClassOf>
            <owl:Restriction>
