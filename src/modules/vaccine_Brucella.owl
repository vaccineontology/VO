            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella melitensis vaccine using live, attenuated rough strain B115 with O-PS present intracellularly but not exposed on surface. Vaccination with B115 conferred significant protective immunity against b. Melitensis 16M and b. Ovis, equivalent to that of Rev. 1 vaccine. No interfering antibodies to O-PS detected.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:18675869</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21300102</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22521283</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella melitensis strain B115 vaccine</rdfs:label>
    </owl:Class>
    


