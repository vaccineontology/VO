        <obo:IAO_0000115>Brucella ovis subunit vaccine using outer membrane complex antigen from Brucella ovis encapsulated in poly-epsilon-caprolactone microparticles prepared by a double emulsion solvent evaporation method (troms), with antigen loading about 13 microg HS per mg microparticles. Vaccination with 800 microg HS-PEC microparticles induced adequate serological response and conferred protection against Brucella ovis challenge similar to that of the live attenuated Rev. 1 vaccine. Adequate serological response against Brucella ovis antigens induced by 800 microg HS-PEC.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:16337315</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella ovis outer membrane complex microparticle subunit vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009174 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009174">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0009012"/>
