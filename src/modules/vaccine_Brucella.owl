                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10141"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Inactivated Brucella melitensis vaccine using live vaccine derived from Brucella melitensis strain Rev. 1. An association between macrophage migration inhibition and resistance to infection was demonstrated. Macrophage migration inhibition and agglutinin response were observed following immunization.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:828715</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>inactivated Brucella melitensis strain Rev. 1 vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0009018"/>
