            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella suis vaccine using live attenuated strain with ctpa gene deletion. Vaccination with the ctpa-deficient strain conferred 4 to 5 log(10) CFU protection against challenge with virulent b. Abortus strain 2308 or b. Suis strain 1330 but no protection against b. Melitensis strain 16 M.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:16077124</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella suis ctpA deletion mutant vaccine</rdfs:label>
    </owl:Class>
    


