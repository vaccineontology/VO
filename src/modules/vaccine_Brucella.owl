                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella ovis vaccine using live attenuated mutant strains with deletion of the ppdk gene impairing growth and virulence. Ppdk mutant showed impaired growth in vitro, inability to multiply in infected cells, and an unusual attenuation pattern in mice with initial higher spleen colonization followed by marked decrease, indicating attenuation and potential as a vaccine candidate.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:32795361</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella ovis pyruvate phosphate dikinase deletion vaccine</rdfs:label>
    </owl:Class>
    


