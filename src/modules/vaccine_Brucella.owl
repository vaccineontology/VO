                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_234"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella RNA vaccine using the vaccine includes epitopes from virb2, virb3, virb6, and btpa proteins linked appropriately for mrna vaccine design. Computational results indicate the vaccine effectively stimulates an. Predicted robust antigenicity of selected proteins and stable vaccine-tlr4 binding suggest potential to stimulate.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:40841725</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella VirB2 VirB3 VirB6 BtpA RNA vaccine</rdfs:label>
    </owl:Class>
    


