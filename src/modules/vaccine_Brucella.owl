                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine using the five recombinant proteins were combined and administered intraperitoneally into balb/c mice. Combination vaccine significantly reduced bacterial colonization in the spleen with a log protection unit of 1.31, comparable to protection conferred by the live attenuated vaccine RB51. Vaccination enhanced cell-mediated immunity as indicated by significantly elevated ifn-γ and reduced IL-10 levels.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:30609879</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus recombinant SodC RibH Ndk L7/L12 MDH subunit vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009414 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009414">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001136"/>
