        <rdfs:label>Brucella abortus BAB1_0273 BAB1_0278 SodC DNA vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009388 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009388">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001221"/>
