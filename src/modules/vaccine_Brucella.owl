                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_11077"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003355"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_234"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella subunit vaccine using Brucella L7/L12 tomp31 somp2b subunit vaccine. Both vaccine regimens conferred protection levels comparable to live vaccines against Brucella challenge. Both vaccine regimens elicited strong specific igg responses with higher igg2a than igg1 titers, indicating a th1-oriented.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>Brucella cocktail protein vaccine (rL7/L12+rTOmp31+rSOmp2b)</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:30343119</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella L7/L12 TOmp31 SOmp2b subunit vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009409 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009409">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001226"/>
