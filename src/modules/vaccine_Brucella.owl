        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus L7/L12 influenza vector vaccine (Flu-NS1-124 construct)</rdfs:label>
    </owl:Class>
    


