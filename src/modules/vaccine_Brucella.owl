                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Inactivated Brucella melitensis vaccine using inactivated Brucella melitensis strain 53 H 38 vaccine with emulsion. Vaccinated mice showed a decrease in challenge bacteria in the spleen during the first two days post-challenge, followed by an increase that remained lower than in unvaccinated controls.</obo:IAO_0000115>
