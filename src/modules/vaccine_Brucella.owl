            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella subunit vaccine using mev-fc was expressed and purified via an escherichia coli expression system. Mev-fc exerted a significant protective effect against Brucella infection compared to the PBS control group. Mev-fc enhanced both th1 and th2.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:40229797</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella Omp19 Omp16 Omp25 L7/L12 multiepitope subunit vaccine</rdfs:label>
    </owl:Class>
    


