                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9860"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003355"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_234"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella DNA vaccine using intramuscular injection of plasmid DNA vector pcibfr, administered three times at 3-week intervals. Induced a strong and long-lived memory. Induced t-cell proliferative response, strong gamma interferon production upon restimulation, and th1-dominated cytokine and igg isotype profile.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>DNA vaccine encoding bacterioferritin of Brucella spp</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:11553569</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella bacterioferritin DNA vaccine</rdfs:label>
    </owl:Class>
    


