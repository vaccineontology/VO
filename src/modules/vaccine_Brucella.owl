                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_11077"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003355"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus recombinant vector vaccine using Brucella abortus omp16 L7/L12 omp19 SOD recombinant influenza viral vector vaccine. Prevented abortion in 66.7% of pregnant sheep and 77.8% of pregnant goats. Induced antigen-specific igg antibodies predominantly of igg2a isotype and also igg1.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:29023541</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32175335</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus Omp16 L7/L12 Omp19 SOD recombinant influenza viral vector vaccine</rdfs:label>
    </owl:Class>
    


