                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine using intraperitoneal injection of a combination of purified recombinant proteins aspc, dps, inpb, and ndk. Combined subunit vaccine showed superior protective effect in mice against brucellosis compared to single antigens and was comparable to the live attenuated vaccine RB51. Vaccine induced a t-helper-1-dominated.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:29678458</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus AspC Dps InpB Ndk subunit vaccine</rdfs:label>
    </owl:Class>
    


