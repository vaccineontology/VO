            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella melitensis subunit vaccine using OMP19 gene was amplified and cloned into the petsumo vector system to produce purified recombinant OMP19 antigen. Recombinant OMP19 antigen showed similar immunogenic power to the commercially available recombinant protein in the mouse model.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:36649106</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella melitensis Omp19 subunit vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009526 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009526">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001135"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/VO_0000208"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/VO_0010038"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0001011"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_11077"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003355"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_29459"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella melitensis vaccine using live attenuated Brucella melitensis 16M strain with an in-frame deletion of the wzm gene, administered by subcutaneous or conjunctival routes. In mice, 16mδwzm prevented placental and fetal infections and protected against Brucella melitensis and Brucella ovis infections. Efficacy in the natural host (sheep) remains to be confirmed. Vaccination induced transient rose bengal serological reactions, stronger and earlier in pregnant ewes.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:36653223</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella melitensis 16M delta wzm vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009527 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009527">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001221"/>
        <rdfs:subClassOf>
