            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Inactivated Brucella vaccine using inactivated Brucella split conjugated vaccine. Split-conjugated vaccine combined with fosprenil induced higher antibody titers that persisted longer compared to the vaccine combined with polypeptide C or vaccine alone. Vaccine with fosprenil enhanced the humoral.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>split-conjugated animal brucellosis vaccine</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:32546922</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>inactivated Brucella split conjugated vaccine</rdfs:label>
    </owl:Class>
    


