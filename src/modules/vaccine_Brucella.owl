                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using live attenuated Brucella abortus strain 2308 delta gntr vaccine. 2308ΔgntR mutant induced high protective immunity in balb/c mice challenged with wild-type b. Abortus 2308. Induced anti-brucella-specific immunoglobulin G (igg) response.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:29055858</obo:IAO_0000119>
