                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_29459"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000117>Oliver He</obo:IAO_0000117>
        <obo:IAO_0000117>Rebecca Racz</obo:IAO_0000117>
        <obo:IAO_0000118>B. abortus and B. melitensis mutants with unmarked deletion of asp24, virB2, or manBA</obo:IAO_0000118>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:comment>A asp24 mutation in Brucella abortus is attenuated and provides significant protection in mice</rdfs:comment>
        <rdfs:comment>A virB2 mutant is attenuated in Brucella melitensis and provides protection in mice</rdfs:comment>
        <rdfs:comment>Mutants manB and manA were attenuated in Brucella melitensis and provided protection against challenge in mice&apos;s livers</rdfs:comment>
        <rdfs:comment>Unmarked rough B. abortus and B. melitensis deletion mutants of manBA (including manA and manB) were attenuated. These mutants provided protection against virulent Brucella challenge in mice</rdfs:comment>
        <rdfs:label>live attenuated Brucella abortus and Brucella melitensis unmarked deletion mutant vaccine</rdfs:label>
    </owl:Class>
    


