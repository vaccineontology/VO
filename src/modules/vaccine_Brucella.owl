                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus recombinant vector vaccine using recombinant vaccinia virus expressing Brucella abortus L7/L12 protein. Mice inoculated with WRL7/L12 produced antibodies specific to vaccinia virus and L7/L12 antigens but were not protected against virulent Brucella abortus 2308 challenge. Mice produced predominantly igg2a isotype antibody responses indicative of a th1 type.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:15941627</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus L7/L12 vaccinia recombinant vector vaccine (WRL7/L12)</rdfs:label>
    </owl:Class>
    


