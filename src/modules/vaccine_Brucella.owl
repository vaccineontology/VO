                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using live attenuated Brucella abortus strain znbaz vaccine. Znbaz strain resulted in nearly complete protection of mice against pulmonary challenge with wild-type brucella, associated with a dominant cd8+ T cell response. Znbaz induced up to a 5-fold increase in ifn-γ-producing NK cells in mouse lungs, with increased expression of cxcr3, ki67, nkp46, and granzyme b, and decreased NKG2A.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:34305935</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus strain znBAZ vaccine</rdfs:label>
    </owl:Class>
    


