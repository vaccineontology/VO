                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella melitensis subunit vaccine using Brucella melitensis lpp-ompa btae subunit vaccine. Immunization elicited robust b-cell responses with a th1-biased antibody profile (elevated igg2a/igg1 ratios), increased interferon-γ/interleukin-4 levels, and increased cd8+/cd4+ t-cell ratio, indicating strong cell-mediated immunity.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:40715363</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella melitensis Lpp-OmpA BtaE subunit vaccine</rdfs:label>
    </owl:Class>
    


