            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003355"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_29461"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella suis subunit vaccine using Brucella suis bepc multi-epitope subunit vaccine. Computational analyses suggest the MEV is highly antigenic, non-toxic, non-allergenic, flexible, stable, and soluble, with strong predicted interactions with TLR4 and hlas, supporting its potential efficacy against Brucella suis infections. Predicted to induce t-cell and b-cell.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:36459272</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella suis BepC multi-epitope subunit vaccine</rdfs:label>
    </owl:Class>
    


