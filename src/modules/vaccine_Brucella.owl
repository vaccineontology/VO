                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_29459"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella melitensis subunit vaccine using the omp25 gene was amplified, cloned into ptz57r/t vector, and expressed using pet32(a)+ vector in E. Coli BL21 (de3) strain, producing a 42 kda protein. Omp25 gene is proposed as a candidate useful for stimulation of cell-mediated and humoral immunity in future studies.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:27920824</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella melitensis Omp25 subunit vaccine</rdfs:label>
    </owl:Class>
    


