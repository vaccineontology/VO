                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using live attenuated Brucella abortus flu-ba influenza vector vaccine. Complete protection in 57.1% of sheep and 42.9% of goats against b. Melitensis 16M challenge. No antibody response against Brucella omp16 and L7/L12 proteins detected up to 56 days post-initial vaccination.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:27938677</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus Flu-BA influenza vector vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009372 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009372">
