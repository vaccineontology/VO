        <obo:IAO_0000118>Brucella CGV26</obo:IAO_0000118>
        <obo:IAO_0000118>CGV26</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:16519974</obo:IAO_0000119>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella melitensis delta bp26 vaccine</rdfs:label>
    </owl:Class>
    


