        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Inactivated Brucella melitensis vaccine using gamma-irradiated Brucella melitensis bacteria that are nondividing but metabolically active. Irradiated vaccine protected mice against virulent bacterial challenge without residual virulence. Vaccine generated antigen-specific cytotoxic T cells and persisted in macrophages, indicating induction of cellular immunity.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:19703982</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>inactivated Brucella melitensis gamma irradiated vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009219 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009219">
