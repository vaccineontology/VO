                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine using outer membrane protein of Brucella abortus strain S19 entrapped in a commercial cationic liposome. Mice immunized with the s19-omp-liposome showed enhanced protection compared to mice inoculated with S19 OMP alone, live b. Abortus S19 vaccine, or liposome alone (p&lt;0.05). The.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:27656221</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus strain 19 Omp cationic liposome subunit vaccine (S19-OMP-liposome)</rdfs:label>
    </owl:Class>
    


