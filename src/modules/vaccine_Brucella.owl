                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_234"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella subunit vaccine using Brucella lumazine synthase ova(257-264) subunit vaccine. Immunization induced rapid activation and proliferation of ova(257-264)-specific cd8+ T cells, generation of cd8+ effector cells, and a strong peptide-specific cytotoxic response dependent on TLR4 signaling. Vaccine induced cross presentation of the peptide antigen, activation of cd8+ lymphocytes expressing activation markers CD69 and cd44, decreased il-7rα expression indicating effector cell generation, and tlr4-dependent cytotoxic T lymphocyte responses without adjuvants.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:23029192</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella lumazine synthase OVA(257-264) subunit vaccine</rdfs:label>
    </owl:Class>
    


