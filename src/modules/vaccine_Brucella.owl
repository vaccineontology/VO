                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella melitensis vaccine using live attenuated Brucella melitensis strain M5 with pure and purk gene deletions. Mutant vaccine conferred protection against infection with virulent wild-type Brucella melitensis strain 16M comparable to parental strain M5. Induced anti-brucella-specific igg, secretion of ifn-γ, low IL-6 levels, and mild histopathological changes with reduced cytotoxicity compared to parental strain.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>purE/purK gene-deletion mutant of Brucella melitensis vaccine strain M5</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:39828225</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella melitensis strain M5 purE purK gene-deletion vaccine</rdfs:label>
    </owl:Class>
    


