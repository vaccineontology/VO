            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella vaccine using live rough salmonella bacterial vector delivering Brucella antigens. In vitro, the vaccine induced significantly lower levels of inflammatory and pyretic cytokines tnf-α and il-1β compared to wild-type salmonella.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:29486945</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella vaccine using rough Salmonella vector</rdfs:label>
    </owl:Class>
    


