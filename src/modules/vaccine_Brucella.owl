            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using live attenuated mutant strain with virb12 gene deletion, administered intraperitoneally at 5.0 x 10^4 CFU dose. A19-delta virb12 mutant provided statistically significant protection against Brucella abortus 2308 challenge, comparable to the parental A19 strain. Western blotting confirmed absence of virb12 protein expression.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:24617263</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus strain A19 delta VirB12 vaccine</rdfs:label>
    </owl:Class>
    


