            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Inactived Brucella vaccine using Brucella neotomae rendered non-replicative by gamma-radiation and overexpressing SOD aiming to prevent human brucellosis.Vaccinated mice showed significant resistance against challenge with virulent b. Abortus, b. Melitensis, and b. Suis. Induction of antigen-specific antibody and T cell responses.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:21109033</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>gamma irradiated Brucella neotomae SOD vaccine</rdfs:label>
    </owl:Class>
    


