            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine using recombinant adk protein purified after expression in escherichia coli dh5α. Vaccination with recombinant adk protein significantly reduced spleen bacterial burden compared to PBS control, indicating protection against b. Abortus infection. Induced strong proinflammatory cytokines TNF and IL-6.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>combination of recombinant Brucella abortus proteins Adk and SecB subunit vaccine</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:32169487</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus Adk SecB combination subunit vaccine</rdfs:label>
    </owl:Class>
    


