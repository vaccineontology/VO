                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using the S19-GFP vaccine maintained all biochemical characteristics of the parental S19 vaccine and expressed GFP allowing identification under ultraviolet light. S19-gfp protected mice against virulent Brucella abortus challenge to the same extent as the parental S19 vaccine. Both S19-GFP and S19 vaccines induced similar levels of antibodies against lipopolysaccharide.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:21056079</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34807952</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus strain 19 GFP vaccine</rdfs:label>
    </owl:Class>
    


