            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella canis subunit vaccine using Brucella canis omp31 subunit vaccine. Recombinant omp31 with different adjuvants and the prime-boost strategy conferred protection against b. Canis infection in mice. Strong igg antibody response induced.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>recombinant Brucella Omp31 antigen vaccine</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:25339409</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella canis Omp31 subunit vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009313 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009313">
