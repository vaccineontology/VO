            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Combination vaccine using live attenuated Brucella abortus BLS PrpA omp19 sodc salmonella typhimurium vector vaccine. Immunized goats showed significantly higher protection demonstrated by lower bacterial loads in most tissues, reduced expression of Brucella antigens in spleen, kidney, and lung, and ameliorated histopathological lesions compared to non-immunized controls. Significantly higher serum igg titers against individual Brucella antigens and elevated interferon-γ production from peripheral blood mononuclear cells in vaccinated groups compared to non-immunized goats.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:29929362</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus BLS PrpA Omp19 SodC Salmonella Typhimurium vector vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009404 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009404">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001221"/>
