                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella ovis vaccine using the vaccine was formulated as an encapsulated live attenuated δabcba strain. Single or multiple immunizations with non-encapsulated strain provided mild protection with reduced liver bacterial loads but not spleen.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:25947146</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella ovis strain delta abcBA vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009329 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009329">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0009007"/>
