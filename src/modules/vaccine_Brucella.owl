                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella vaccine using live attenuated salmonella typhimurium strain JOL1800 secreting Brucella sodc and omp19 antigens. Addition of sodium bicarbonate significantly increased anti-brucella-specific systemic igg levels, lymphocyte proliferation, cd4+ T cell responses, and enhanced salmonella colonization in the intestine, indicating improved protective. Induction of a mixed th1-th2 response evidenced by increased systemic igg, lymphocyte proliferation, and cd4+ T cell responses following vaccination with sodium bicarbonate-enhanced formulation.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:31705999</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella SodC and Omp19 vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009439 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009439">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0009024"/>
