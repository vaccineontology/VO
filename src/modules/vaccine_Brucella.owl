                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9986"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella melitensis subunit vaccine using recombinant fusion protein (rtob) expressed in escherichia coli BL21-DE3 and purified by ni-nta agarose column. Antibodies against rtob were detected in 76.5% of sera from infected patients. Fusion protein elicited antibody responses in both vaccinated rabbits and infected human patients, indicating immunogenicity.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:26019797</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella melitensis trigger factor Omp31 BP26 fusion subunit vaccine</rdfs:label>
    </owl:Class>
    


