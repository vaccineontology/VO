                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus conjugate vaccine using bioconjugate vaccine produced by glycosylation of Y. Enterocolitica o:9 with o-antigen polysaccharide from B. Abortus. Vaccine elicited b. Abortus ops-specific serum igg, significantly reduced bacterial loads in spleen, mitigated infection, prevented severe tissue damage, and protected mice against lethal challenge with b. Abortus strain A19. Strong.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:32244903</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus O-polysaccharide conjugate vaccine</rdfs:label>
    </owl:Class>
    


