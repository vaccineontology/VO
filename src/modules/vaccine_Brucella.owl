                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine using Brucella abortus omp19-p39 chimeric rop subunit vaccine. Vaccination with rop reduced bacterial CFU significantly (p&lt;0.01) in macrophage cell lines and organs of mice after challenge with virulent Brucella species. Rop alone induced strong igg response dominated by igg2a and significant ifn-γ production by splenic T cells.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:29106986</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus Omp19-P39 chimeric rOP subunit vaccine</rdfs:label>
    </owl:Class>
    


