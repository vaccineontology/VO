                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine using A divalent recombinant vaccine consisting of omp25 and L7/L12 proteins of Brucella abortus was formulated and evaluated individually and in combination. Mice immunized with the combined omp25+l7/l12 vaccine exhibited superior log10 protection against virulent Brucella abortus 544 compared to individual vaccines. Combined vaccine induced enhanced igg titers specific to both antigens.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>Omp25 and L7/L12 divalent recombinant vaccine</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:32102449</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus Omp25 and L7/L12 divalent recombinant protein vaccine</rdfs:label>
    </owl:Class>
    


