            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella melitensis subunit vaccine using recombinant individual lrp/asnc family proteins expressed in escherichia coli and purified. All six lrp/asnc proteins induced protective. Induction of antibodies against the lrp/asnc proteins was observed in immunized mice.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:26579099</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella melitensis Lrp/AsnC family protein subunit vaccine</rdfs:label>
    </owl:Class>
    


