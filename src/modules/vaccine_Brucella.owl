                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella melitensis subunit vaccine using recombinant hspa protein was cloned in pdest42 and used as a subunit vaccine. Administration of recombinant hspa resulted in a significant reduction in bacterial load and a high degree of protection against Brucella melitensis challenge compared to control mice (p&lt;0.001). Vaccine elicited mixed TH1/TH2.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:24995396</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella melitensis HspA subunit vaccine</rdfs:label>
    </owl:Class>
    


