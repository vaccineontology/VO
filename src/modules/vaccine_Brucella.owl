        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003355"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using attenuated salmonella typhimurium strain JOL1800 (∆lon, ∆cpxr, ∆asd, and ∆rfal) transformed with plasmid pjhl65::l7/l12 secreting the L7/L12 antigen. Immunized mice showed significant reduction in Brucella colonization in spleen and liver tissues after challenge with virulent b. Abortus compared to controls. Vaccine elicited Brucella antigen-specific th1 and th2.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>Live vaccine consisting of attenuated Salmonella secreting and delivering Brucella ribosomal protein L7/L12</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:31973749</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus L7/L12 Salmonella Typhimurium vector vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009447 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009447">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001223"/>
        <rdfs:subClassOf>
