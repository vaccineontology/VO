            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine using extracted Brucella cell surface protein (bcsp) used alone or in combination with other proteins or PKLPS. Bcsp was immunogenic and protective in mice, showing reduced splenic bacterial load and weight compared to controls. Induced serologic responses detected by ELISA.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:2118744</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus 2308 proteinase K-treated lipopolysaccharide subunit vaccine</rdfs:label>
    </owl:Class>
    


