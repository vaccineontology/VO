            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus recombinant vector vaccine using live attenuated salmonella typhimurium vector expressing Brucella abortus PrpA protein (st-prpa). Immunized mice showed significantly quicker anti-salmonella igg responses and increased protection against salmonella challenge compared to salmonella vector only. Increased IL-4 production in vitro from pulsed mice splenocytes indicating enhanced humoral immunity without major interference on cell mediated immunity.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:29433066</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus PrpA recombinant vector vaccine</rdfs:label>
    </owl:Class>
    


