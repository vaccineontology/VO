        <obo:IAO_0000115>Brucella abortus subunit vaccine using recombinant HSA-L7/L12 fusion protein expressed in saccharomyces cerevisiae and purified by affinity chromatography. Combination of thsa-l7/l12 fusion protein with LPS and b. Abortus S19 induced higher protection against virulent b. Abortus 544 challenge than other groups (p = 0.005). Combination vaccine elicited significantly higher antibody titers than LPS alone and l7/l12+lps.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:21053778</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus HSA-L7/L12 and lipopolysaccharide subunit vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009230 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009230">
