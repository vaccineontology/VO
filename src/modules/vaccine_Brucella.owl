                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_29459"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella melitensis vaccine using lipopolysaccharide extracted from Brucella melitensis baca gene deletion mutant (bm-δbaca) used to stimulate immune cells. Lps from baca gene deletion mutant disrupted immune suppression and promoted inflammatory factor production, contrasting with wild-type LPS which suppressed. Robust T cell.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:40157278</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella melitensis BacA gene deletion vaccine</rdfs:label>
    </owl:Class>
    


