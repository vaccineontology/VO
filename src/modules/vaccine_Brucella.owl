            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine contains protein-bound cell wall peptidoglycan subunit that completely stopped dissemination of Brucella abortus 544 infection to the spleen in mice. </obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>protein-bound cell wall peptidoglycan Brucella fraction vaccine</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:6408007</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus protein-bound cell wall peptidoglycan subunit vaccine</rdfs:label>
    </owl:Class>
    


