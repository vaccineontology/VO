                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10141"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using live attenuated salmonella typhimurium vector expressing Brucella proteins sod, omp19, bls, and PrpA combined with purified Brucella abortus lipopolysaccharide. Vaccinated guinea pigs showed a protective index of 1.52 based on differential splenic bacterial counts and reduced histopathological lesions compared to non-immunized controls.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:29249316</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus SodC Omp19 BLS PrpA Salmonella vector vaccine</rdfs:label>
    </owl:Class>
    


