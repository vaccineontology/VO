            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella subunit vaccine using recombinant urease protein cloned in pet28a vector and administered as a subunit vaccine via subcutaneous and intraperitoneal routes. Subcutaneous vaccination conferred a higher degree of protection against virulent Brucella melitensis, b. Abortus, and b. Suis challenge compared to intraperitoneal vaccination (p ≤ 0.05). Rurease induced mixed th1-th2.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>recombinant Brucella urease (rUrease) vaccine</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:25939375</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella urease subunit vaccine</rdfs:label>
    </owl:Class>
    


