                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10141"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Inactivated Brucella abortus vaccine using the vaccine was prepared by sequential biological lysis and hydrogen peroxide treatment resulting in bacterial ghosts with typical morphology and genetic stability. Immunization with A19BG conferred a similar level of protection as the existing A19 vaccine against Brucella melitensis M28 in both guinea pigs and cattle. Vaccinated guinea pigs showed antibody levels, interferon-γ, interleukin-4, and cd4+ T cell responses comparable to those induced by the existing A19 vaccine.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:34919994</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus strain 19 bacterial ghost vaccine</rdfs:label>
    </owl:Class>
    


