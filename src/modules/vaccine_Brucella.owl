            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using live attenuated Brucella abortus strain 19 with htra gene deletion. Htra mutant showed significantly reduced spleen colonization at 1 week and enhanced clearance at 4 and 7 weeks post-infection compared to parental strain. Mutant elicited equivalent delayed type hypersensitivity and antibody responses compared to the parental strain in balb/c mice.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:8734637</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus strain 19 htrA gene deletion vaccine</rdfs:label>
    </owl:Class>
    


