                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus DNA vaccine using Brucella abortus pcdna-sod DNA vaccine with bppcysmpeg. Pcdna-sod/bppcysmpeg formulation induced improved protection against virulent b. Abortus 2308 challenge compared to pcdna-sod alone. Induced antigen-specific humoral responses (igg2a, igg1, secretory iga), t-cell proliferative responses, increased gamma interferon production, and cytotoxic responses demonstrated by lysis of infected macrophages.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>DNA vaccine encoding Cu,Zn superoxide dismutase of Brucella abortus</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:25165025</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus pcDNA-SOD DNA vaccine with BPPcysMPEG adjuvant</rdfs:label>
    </owl:Class>
    


