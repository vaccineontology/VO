                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine using Brucella abortus D15 protein subunit vaccine - not vaccine. Vaccination with recombinant mdh resulted in the most significant reduction in bacterial colonization compared to other antigens tested. Mice immunized with mdh maintained higher levels of ifn-γ in spleens compared to other treatment groups, indicating enhanced.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:21412420</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus D15 protein subunit vaccine</rdfs:label>
    </owl:Class>
    


