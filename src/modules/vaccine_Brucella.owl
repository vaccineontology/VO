                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella melitensis recombinant vector vaccine using recombinant escherichia coli expressing the omp31 gene. No significant protection against challenge with smooth Brucella melitensis H38S was observed. Induction of specific antibodies to Brucella melitensis in serum, increased after boosting.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:22546330</obo:IAO_0000119>
