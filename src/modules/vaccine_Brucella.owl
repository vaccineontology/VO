            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Inactivated Brucella abortus vaccine prepared by adding sodium dodecyl sulphate to intact cultures of virulent Brucella abortus grown in a defined medium containing erythritol. Purified whole-culture vaccine immunized mice better than crude killed organisms, extracted washed organisms, or extracted culture supernatant vaccines. Vaccine was less allergenic in infected guinea pigs and less toxic to mice compared to crude killed Brucella abortus suspensions.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:4998841</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>inactivated Brucella abortus purified killed vaccine</rdfs:label>
    </owl:Class>
    


