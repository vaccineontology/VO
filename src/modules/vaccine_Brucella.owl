        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella VirB9 VirB10 Omp19 Omp25 IgV CTLA-4 subunit vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009562 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009562">
