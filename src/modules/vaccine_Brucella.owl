                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using live bvrs/bvrr mutant cells used alone or in combination with wbka mutant or inactivated bvrs cells or purified S-LPS. Bvrs mutant alone protected against virulent b. Abortus but less effectively than when combined with the wbka mutant. Bvrs-wbka combination induced an antibody response reduced compared to b. Abortus strain 19 vaccination.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:16439039</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus bvrS/bvrR mutant vaccine</rdfs:label>
    </owl:Class>
    


