                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003355"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_90371"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Combination vaccine using mixture of three delivery strains of live, attenuated salmonella typhimurium expressing the three Brucella abortus proteins. Intraperitoneal immunization with the vaccine candidate significantly reduced Brucella abortus strain 544 colonization in spleen (&lt;10^3 cfu), indicating effective protection. Significant increases in serum igg, tnf-α, and ifn-γ concentrations were observed in immunized groups compared to control, except for omp3b in oral immunization group.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>Live, attenuated Salmonella Typhimurium vaccine candidate expressing BCSP31, Omp3b, and SOD proteins of Brucella abortus</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:27148232</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:28873944</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30068897</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus BCSP31 Omp3b SOD live attenuated Salmonella Typhimurium vector vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009364 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009364">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001134"/>
