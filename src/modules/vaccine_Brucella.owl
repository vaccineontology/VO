                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using live attenuated double mutant strain of Brucella abortus 2308 with deletions in znua and pure genes. Two doses of the double mutant conferred 0.79 log protection, similar to S19 vaccine. Double mutant was less capable of surviving in macrophages and caused significantly less inflammation in spleens of infected mice compared to wild-type strain.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:19914192</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus strain 2308 znuA purE double mutant vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009221 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009221">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001223"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
