                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10141"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Inactivated Brucella abortus vaccine using 300 microgram of killed strain 45/20 cells in 1% oil emulsion with tdm, mdp, or both. Protection induced by bacterins containing 50 to 1,000 microgram of TDM or TDM-MDP was comparable to that of live strain 19 vaccine. Immunopotentiation was enhanced by TDM.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:6802042</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>inactivated Brucella abortus strain 45/20 vaccine with trehalose dimycolate and muramyl dipeptide adjuvants</rdfs:label>
    </owl:Class>
    


