            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella vaccine using live pgm mutant strain of Brucella. Pgm mutant showed reduced adhesion and infection of human trophoblast cells compared to Brucella vaccine strain M5-90. Increased activity of il-6, tnf-alpha, and lactic dehydrogenase in human trophoblast cells infected by the pgm mutant compared to Brucella vaccine strain M5-90.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:23173442</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella pgm mutant vaccine</rdfs:label>
    </owl:Class>
    


