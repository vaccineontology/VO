    <!-- http://purl.obolibrary.org/obo/VO_0009401 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009401">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001134"/>
