                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella melitensis vaccine using live attenuated mutants administered once by intraperitoneal route. Znbmz vaccination reduced splenic brucellae colonization by approximately 25,000-fold compared to PBS controls, outperforming b. Abortus S19 vaccine which reduced colonization by 700-fold. Both znbmz and S19 induced ifn-γ+ cd4+ T cells and cd4+ effector memory T cells.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:38257995</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella melitensis znBM-lacZ vaccine</rdfs:label>
    </owl:Class>
    


