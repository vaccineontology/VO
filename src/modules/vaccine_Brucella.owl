                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_29459"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella melitensis subunit vaccine using the vaccine was designed as a multi-epitope recombinant subunit vaccine combining epitopes from omp31, omp25, and omp28 antigens joined by flexible linkers. Designed vaccine showed high quality and acceptable physicochemical properties with predicted ability to induce humoral and cellular. Vaccine is predicted to induce both humoral and cellular.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:38019359</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella melitensis Omp31 Omp25 Omp28 recombinant subunit vaccine</rdfs:label>
    </owl:Class>
    


