            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine using recombinant L7/L12 ribosomal protein. Not directly reported. Induced antigen-specific proliferation of cd4+ T cells with a th1 cytokine profile characterized by IL-2 and ifn-gamma transcripts and secretion of ifn-gamma, but not IL-4.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:26442664</obo:IAO_0000119>
