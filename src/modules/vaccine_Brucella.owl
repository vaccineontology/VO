                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003355"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using RB51 was transformed with two broad-host-range plasmids: pbbr1ori-llo containing llo, and pblu-mllo-bax-smac containing mutant LLO and BAX-SMAC fusion gene, generating recombinant RB51 strains. Recombinant RB51 strains expressing mllo and BAX-SMAC showed higher cytotoxicity, reduced macrophage survival, and increased apoptosis and necrosis compared to parental rb51. Vaccination with rb51-mllo-bax-smac enhanced th1. Enhanced T cell-mediated immunity, primarily through bacterial endosome escape and antigen cross-priming, leading to increased ifn-γ production and a stronger th1 response, potentially improving safety and efficacy of the vaccine candidate.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>Recombinant Brucella abortus RB51 vaccine expressing listeriolysin O, BAX, and SMAC</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:35335018</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus RB51 recombinant vaccine expressing LLO, BAX and SMAC</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009509 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009509">
