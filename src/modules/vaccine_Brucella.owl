                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9925"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus recombinant vector vaccine using A mixture of three Brucella vaccine strains using a salmonella-based delivery system, each expressing one of the recombinant B. Abortus proteins omp3b, bcsp31, or sod, administered at 3.0 × 10^9 cfu/ml. 40% of vaccinated animals were protected against b. Abortus infection. The infection index and colonization of b. Abortus in tested tissues were significantly lower in vaccinated goats compared to controls. Vaccinated goats showed significantly higher serum immunoglobulin G titers and interferon gamma concentrations compared to controls, indicating significant antigen-specific.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:31571725</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus Omp3b/BCSP31/SOD recombinant attenuated Salmonella vector vaccine</rdfs:label>
    </owl:Class>
    


