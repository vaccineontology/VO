                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine using LPS preparations obtained by boivin&apos;s technique, westphal&apos;s technique, and mild alkaline hydrolysis of boivin&apos;s active complex. Lps from b. Melitensis virulent strain 565 had a more pronounced disturbing effect on hematopoiesis than LPS from b. Abortus vaccine strain 19-BA. Lipid A at doses 0.1-10 micrograms produced no activating effect on hematopoiesis characteristics studied.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:3931396</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus strain 19 BA lipopolysaccharide vaccine</rdfs:label>
    </owl:Class>
    


