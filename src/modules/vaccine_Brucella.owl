                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10141"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine using Brucella abortus ABOR recombinant protein subunit vaccine. Abor recombinant protein induced a strong th1. Induction of cellular and humoral immunity characterized by elevated ifn-γ, il-2, il-12, tnf-α, and igg2a, indicating effective stimulation of th1 immunity.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:39606679</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus ABOR recombinant protein subunit vaccine</rdfs:label>
    </owl:Class>
    


