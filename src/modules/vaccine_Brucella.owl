            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus RNA vaccine using lipid nanoparticle-encapsulated nucleoside-modified mrna vaccine encoding omp25 fused with fc (omp25-fc mrna-lnp). Omp25-fc mrna-lnp vaccine induced significantly stronger humoral and cellular. Vaccine activated mixed th1/th2.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>BP26-Fc mRNA-LNP vaccine</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:40349401</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus BP26 RNA vaccine</rdfs:label>
    </owl:Class>
    


