                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella melitensis subunit vaccine using five chimeric clps were assembled in plants, each presenting a different T cell epitope. One of the three chimeric clps induced protection against virulent Brucella strain challenge equivalent to the commercial Rev. 1 vaccine.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>Plant-expressed chimeric core-like particle vaccine presenting Brucella melitensis T cell epitopes</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:38930429</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella melitensis T cell epitope virus-like particle subunit vaccine</rdfs:label>
    </owl:Class>
    


