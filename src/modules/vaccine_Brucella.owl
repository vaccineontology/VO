    <!-- http://purl.obolibrary.org/obo/VO_0009468 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009468">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001134"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/VO_0000208"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/VO_0010038"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0001011"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_11077"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003355"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using live attenuated Brucella abortus strain 104M delivered via three routes: intratracheal aerosol, intranasal instillation, and subcutaneous injection. Immunized mice showed no abnormal clinical symptoms or significant body weight changes. Spleen weights post-challenge were significantly lower in immunized groups compared to controls. Bacterial loads in spleens decreased over time and were significantly lower than controls after challenge. High titers of specific antibodies were detected, peaking at week 8. Cytokine levels (ifn-γ, il-18) were elevated pre-challenge and modulated post-challenge. No significant differences were observed among immunization routes. The vaccine showed obvious protective efficacy against aerosol challenge. Both humoral and cellular immunity were stimulated by the vaccine. High titers of Brucella 104m-specific igg2a antibodies were detected, higher than igg1. Cytokines ifn-γ, il-18, and il-1β concentrations in serum and lung homogenate were significantly elevated in immunized groups before challenge. After challenge, serum cytokine levels decreased compared to controls, while lung cytokine levels remained elevated.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:32741179</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus strain 104M vaccine</rdfs:label>
    </owl:Class>
    


