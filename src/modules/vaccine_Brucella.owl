                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine using Brucella abortus bsph subunit vaccine. Immunization with rbsph conferred significant protection against subsequent challenge with b. Abortus A19. Rbsph stimulation induced production of h+ and ca2+ ions (not h2o2) in macrophages.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:41240584</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus BspH subunit vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009597 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009597">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001134"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/VO_0000208"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/VO_0010038"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0001011"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_11077"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003355"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using biological nanoparticles (outer-membrane vesicles) derived from the recombinant bru-m3 strain (omvbru-m3). Omvbru-m3 vaccination conferred better protection against Brucella abortus challenge, improved bacterial clearance, and reduced tissue damage compared to wild-type OMVs. Vaccination elicited stronger humoral responses and ifn-γ-producing th1 cd4+ T cells, with elevated inflammatory cytokine production and modulation of macrophage polarization.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:41272796</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus OMVBru-M3 vaccine</rdfs:label>
    </owl:Class>
    


