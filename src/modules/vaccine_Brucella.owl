                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using live B. Abortus A19 strain at 10^5 cfu/ml (low dose) or 10^6 cfu/ml (high dose) was used alone or combined with inactivated B. Abortus A19 strain at 10^9 cfu/ml. Combined low dose live vaccine plus inactivated vaccine group showed splenic bacterial burden and spleen weight equivalent to the high dose live vaccine group. Combined vaccine group elicited brucella-specific serum igg, ifn-γ, il-4, and cd4+ and cd8+ T cell percentages similar to the high dose live vaccine group, indicating comparable cellular and humoral.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>live B. abortus A19 strain vaccine</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:35366881</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus strain A19 vaccine</rdfs:label>
    </owl:Class>
    


