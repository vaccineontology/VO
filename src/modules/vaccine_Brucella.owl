            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella melitensis conjugate vaccine using conjugate of Brucella melitensis o-polysaccharide and bovine serum albumin (bsa). Immunization with 10 micrograms of conjugate conferred significant protection against virulent challenge with b. Melitensis h38, similar to the reference vaccine H38. Induced production of antibodies.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:1811374</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella melitensis O-polysaccharide conjugate subunit vaccine</rdfs:label>
    </owl:Class>
    


