            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using A 66kda chimeric antigen composed of espa, intimin, tir, and H7 flagellin (eith7) from STEC was constructed and expressed in Brucella abortus δpgm vaccine strain (babδpgm). Mice immunized with babδpgm(eith7) cleared intestinal e. Coli o157:h7 infection three times faster (4 days) than mice immunized with babδpgm carrier strain (12 days). Induction of anti-eith7 iga antibodies and protective.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:25820069</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus delta pgm E. coli O157:H7 recombinant vaccine</rdfs:label>
    </owl:Class>
    


