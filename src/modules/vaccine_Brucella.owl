                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Inactivated Brucella abortus vaccine using oil-in-water emulsions of the nonionic block polymer T150R1 combined with killed Brucella abortus antigen. Chickens treated with T150R1 polymer developed higher igm antibody titers to sheep erythrocytes and killed Brucella abortus compared to untreated controls. Increased igm antibody response.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:15106737</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>inactivated Brucella abortus T150R1-adjuvanted vaccine</rdfs:label>
    </owl:Class>
    


