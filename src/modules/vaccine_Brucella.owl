                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine using vaccines were prepared from BCSP70 and BCSP100 protein fractions and four subfractions (bcsp100-a through bcsp100-d) purified by anion-exchange HPLC. Vaccines prepared from BCSP70 and BCSP100 were moderately protective and immunogenic. Mpl modulated immunoglobulin G responses induced by bcsp70, bcsp100, and BCSP100-B vaccines.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:3125668</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:8550206</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus strain 19 salt-extractable protein subunit vaccine</rdfs:label>
    </owl:Class>
    


