                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine using Brucella abortus apolipoprotein n-acyltransferase subunit vaccine. Vaccinated mice showed reduced viable bacterial counts in liver, spleen, and axillary lymph nodes compared to non-vaccinated controls. Increased production of igg and its fractions.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:34992597</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus apolipoprotein N-acyltransferase subunit vaccine</rdfs:label>
    </owl:Class>
    


