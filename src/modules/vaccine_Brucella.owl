    <!-- http://purl.obolibrary.org/obo/VO_0009508 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009508">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001134"/>
