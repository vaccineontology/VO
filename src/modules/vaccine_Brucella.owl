                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella melitensis subunit vaccine using phenol-insoluble fractions &apos;pi&apos;, &apos;4a&apos;, and &apos;5&apos; extracted from Brucella melitensis. Inoculation with fractions accelerated blood clearance of live Brucella and reduced bacterial multiplication in spleen. Protective activity involved antibodies and other serum constituents, suggesting roles for both humoral and cellular immunity.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:750371</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella melitensis phenol insoluble fractions subunit vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009035 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0001221"/>
