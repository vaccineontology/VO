                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using live attenuated Brucella abortus strain rb51wboakf with overexpression of wbkf gene and complemented wboa gene, phenotypically rough but expressing higher levels of o-polysaccharide. Immunization with rb51wboakf conferred enhanced protection against virulent b. Abortus 2308, b. Melitensis 16m, and b. Suis 1330 challenge compared to RB51 and rb51wboa vaccine strains. Mice vaccinated with rb51wboakf developed increased levels of smooth lps-specific serum antibodies (igg2a and igg3 isotypes), higher antigen-specific ifn-γ and tnf-α secretion by splenocytes, and increased numbers of antigen-specific ifn-γ secreting cd4+ and cd8+ T lymphocytes compared to RB51 or rb51wboa vaccinated groups.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:30856219</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus strain RB51WboAKF vaccine</rdfs:label>
    </owl:Class>
    


