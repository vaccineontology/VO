                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella vaccine using formulations included smooth and rough variants of salmonella delivery vectors, with or without purified Brucella lipopolysaccharide (lps). Significant reduction of splenic Brucella abortus 544 colonization compared to non-immunized and salmonella-only immunized mice. Increased brucella-specific igg and siga production.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:28622869</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella BLS PrpA Omp19 SodC Salmonella vector vaccine with Brucella lipopolysaccharide adjuvant</rdfs:label>
    </owl:Class>
    


