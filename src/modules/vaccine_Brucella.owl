                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_29459"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella melitensis vaccine using live attenuated vaccine based on Brucella melitensis strain M5-90. Specific t-cell response induced by the M5-90 vaccine was relatively weak and did not sustain long enough, possibly due to rapid activation of t-regulatory cells following vaccination. Low levels of antibodies to BP26 and OMP31 detected.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>attenuated B. melitensis vaccine M5-90</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:24370708</obo:IAO_0000119>
