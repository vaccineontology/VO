            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus DNA vaccine using recombinant plasmid DNA encoding bab1_0267 ORF. Did not provide significant levels of protection against Brucella abortus 2308 infection. Significantly increased igg1 production, ifn-γ levels, and lymphoproliferative response indicating immune activation but no protective efficacy.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:27747197</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus BAB1_0267 DNA vaccine</rdfs:label>
    </owl:Class>
    


