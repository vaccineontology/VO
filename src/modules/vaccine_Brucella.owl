        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using live vaccine strain 19-BA with induced multiresistance to rifampicin, tetracycline, doxycycline, ampicillin, and streptomycin. Immunization with the multiresistant vaccine strain GSA1 and the initial strain 19-BA was demonstrated in guinea pigs.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>B. abortus vaccine strain 19-BA with multiresistance</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:1759514</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus strain 19 BA multiresistant vaccine</rdfs:label>
    </owl:Class>
    


