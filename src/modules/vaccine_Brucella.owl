                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_11077"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003355"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Inactivated Brucella abortus vaccine using lysate prepared from 24 h incubated Brucella abortus S19 broth cultures (~10^8 cfu/ml), adsorbed on aluminium hydroxide gel (0.1% aluminium concentration) with antigenic dose of 0.52 μg protein and 60 μg carbohydrate (cho). Aluminium hydroxide gel adsorbed lysate vaccine exhibited dose-dependent protective potency, with the highest dose showing greater protection than the standard S19 vaccine. Vaccine induced both humoral and cell-mediated.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:26156404</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus strain 19 phage lysate inactived vaccine with aluminium hydroxide gel adjuvant</rdfs:label>
    </owl:Class>
    


