            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella subunit vaccine using Brucella recombinant omp25 protein PLGA nanovaccine. Vaccine candidate conferred higher than 90% protection from Brucella infection in challenge experiments. Both free antigen and nanoparticle formulations induced strong humoral immunity with a threefold increase in brucella-specific igg antibodies.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>recombinant Omp25 protein loaded PLGA nanovaccine</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:38917779</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella recombinant Omp25 protein PLGA nanovaccine</rdfs:label>
    </owl:Class>
    


