            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella melitensis vaccine using A double mutant of the Rev. 1 strain with deletions in fba and tal genes, unable to metabolize erythritol. Rev1δfbaδtal mutant provided comparable protection to the parental Rev. 1 vaccine in mice.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:39457012</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella melitensis strain Rev. 1 delta fba delta tal vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009565 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009565">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VO_0009020"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/VO_0000208"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/VO_0000728"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0001011"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_11077"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003355"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_29459"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella melitensis RNA vaccine using Brucella melitensis omp25 omp31 and mycobacterium tuberculosis MPT70 MPT83 RNA vaccine. Multi-epitope mrna vaccine demonstrated increased antigenicity, non-allergenicity, solubility, high stability, and robust binding affinity to tlr4, suggesting potential efficacy. Immune modeling predicted variations in innate and adaptive immune cell populations including helper T lymphocytes, cytotoxic T lymphocytes, regulatory T lymphocytes, natural killer cells, dendritic cells, and other immune cell subsets following vaccine administration.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:39466745</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella melitensis Omp25 Omp31 and Mycobacterium tuberculosis MPT70 MPT83 RNA vaccine</rdfs:label>
    </owl:Class>
    


