        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9823"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella suis vaccine using live natural rough mutant strain 353-1 administered by conjunctival or intramuscular routes at doses of 5 × 10^7 CFU or 1-2 × 10^10 CFU. Vaccine strain was nonpathogenic, cleared from most vaccinates by 10-12 weeks, did not cause significant tissue lesions, was phenotypically stable, and was not shed to sentinel animals. Vaccination induced significant humoral responses, peripheral blood mononuclear cell proliferation, and interferon-gamma production compared to controls.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:23659743</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella suis strain 353-1 vaccine</rdfs:label>
    </owl:Class>
    


