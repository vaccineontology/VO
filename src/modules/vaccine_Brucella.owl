                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella ovis subunit vaccine using Brucella ovis omp16 subunit vaccine. Monoclonal antibodies to omp16, omp19, and omp31 provided significant protection against b. Ovis challenge, reducing spleen infection and preventing splenomegaly. Protective immunity was mediated by antibodies targeting surface-exposed epitopes of omps and r-lps, confirming the protective role of these antigens and identifying omp31 as a promising subunit vaccine candidate against ram epididymitis.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:10865193</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella ovis Omp16 subunit vaccine</rdfs:label>
    </owl:Class>
    


