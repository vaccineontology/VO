                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus DNA vaccine using intramuscular immunisation of pvaxl9 plasmid DNA. L9 based DNA vaccine conferred significant protection against virulent Brucella abortus challenge in mice. Induction of anti-l9 igg antibodies of both igg1 and igg2a isotypes.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:24950353</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus ribosomal protein L9 DNA vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0009302 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0009302">
