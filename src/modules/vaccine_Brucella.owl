                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0001011"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_11077"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003355"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/VO_0003390"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus DNA vaccine using mycobacterium tuberculosis and Brucella abortus combined DNA vaccine. Dna-il-12(+) immunized mice showed significantly reduced CFU counts in lung and spleen for m. Tuberculosis and b. Abortus, respectively, with better protection than combined DNA vaccine alone or positive controls. Dna-il-12(+) induced stronger antigen-specific ifn-gamma ELISPOT activities, higher cd4(+) and cd8(+) T cell responses, higher antigen-specific igg titers with igg2a skewing, increased ifn-gamma and IL-2 secretion, and decreased IL-4 and IL-10 secretion, indicating enhanced th1-associated.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:17681650</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Mycobacterium tuberculosis and Brucella abortus combined DNA vaccine</rdfs:label>
    </owl:Class>
    


