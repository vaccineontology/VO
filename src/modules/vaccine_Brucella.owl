                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine using Brucella abortus strain 2308 hot-sds-insoluble cell-envelope fraction (pg) subunit vaccine. Mice vaccinated with native cell envelopes displayed protective immunity equivalent to PG vaccine. Both native and PG vaccines stimulated lymphocyte blastogenesis and delayed hypersensitivity to porin and group 3 proteins with no significant difference.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:3133872</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus strain 2308 hot-SDS-insoluble cell-envelope fraction (PG) subunit vaccine</rdfs:label>
    </owl:Class>
    


