                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using live attenuated Brucella abortus strain 2308 delta nodv delta nodw vaccine. Mutant showed significantly reduced survival in macrophages and mice, no splenomegaly in inoculated mice, and conferred high protective immunity against challenge with wild-type strain 2308 in balb/c mice. Induced anti-brucella-specific igg antibody response.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:28131952</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus strain 2308 delta NodV delta NodW vaccine</rdfs:label>
    </owl:Class>
    


