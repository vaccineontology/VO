            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brucella abortus subunit vaccine using recombinant glycoprotein consisting of n-formylperosamine polymer conjugated to acra protein produced in yersinia enterocolitica O9. Glycoprotein induced an igg response recognizing Brucella O antigen but did not confer protection against virulent Brucella abortus challenge in mice. Igg antibody response specific to Brucella O antigen was generated in mice following glycoprotein injection.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000119>PMID:22276812</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>Brucella abortus N-formylperosamine polymer AcrA subunit vaccine</rdfs:label>
    </owl:Class>
    


