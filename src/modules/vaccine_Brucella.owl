            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Live attenuated Brucella abortus vaccine using two-dose conjunctival vaccine from vaccine brand A. Only 13% of animals developed antibody titers one month after vaccination. Low and short-term antibody response.</obo:IAO_0000115>
        <obo:IAO_0000117> Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000117>VaxAgent </obo:IAO_0000117>
        <obo:IAO_0000118>Brucella abortus S19 vaccine (conjunctival form, vaccine brand B)</obo:IAO_0000118>
        <obo:IAO_0000119>PMID:39858212</obo:IAO_0000119>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T08:06:33Z</terms:date>
        <oboInOwl:inSubset>vaccine</oboInOwl:inSubset>
        <rdfs:label>live attenuated Brucella abortus strain 19 vaccine (conjunctival form)</rdfs:label>
    </owl:Class>
    


